# Copie este arquivo para .env e ajuste os valores.

# ---- Servidor ----
PORT=3000

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=posvendas

# ---- Primeiro acesso (usado só quando o banco está vazio) ----
ADMIN_EMAIL=admin@posvendas.local
ADMIN_SENHA=troque-esta-senha
# "nao" para começar sem clientes/equipamentos de exemplo
SEED_EXEMPLOS=sim

# ---- Alertas por e-mail (SMTP) ----
# Ex.: Gmail com senha de app → SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pós-vendas <alertas@suaempresa.com.br>"

# ---- Alertas no celular (SMS / WhatsApp via webhook) ----
# O servidor faz POST JSON {"telefone": "11999998888", "mensagem": "..."} neste endereço.
# Funciona com n8n, Make, Zapier ou com o gateway do seu provedor de SMS/WhatsApp.
ALERTA_WEBHOOK_URL=
ALERTA_WEBHOOK_TOKEN=
